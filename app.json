{
  "expo": {
    "name": "KisanPlan",
    "slug": "kisanplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#1E4D2B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KisanPlan uses your location to load weather and soil advice for your field."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KisanPlan uses a crop photo to check the plant.",
          "cameraPermission": "KisanPlan uses the camera to photograph a leaf.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
